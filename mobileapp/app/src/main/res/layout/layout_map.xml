<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Full-screen interactive map canvas -->
    <com.diplomates.firesafe.ui.custom.InteractiveFireMapView
        android:id="@+id/fullInteractiveMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating bar with layer toggles and search/location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Location chip & Recenter button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/pill_radius"
                app:cardElevation="3dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvMapCurrentLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Pune, Maharashtra • Monitored Safe Zone"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recenter GPS button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMapRecenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="Recenter"
                app:backgroundTint="@color/surface"
                app:elevation="3dp"
                app:fabCustomSize="48dp"
                app:srcCompat="@drawable/ic_compass"
                app:tint="@color/primary" />
        </LinearLayout>

        <!-- Horizontal Layer Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMapLayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerFire"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🔥 Hotspots" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerRisk"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🟠 Risk Polygons" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerShelters"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🛡️ Safe Shelters" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerRoute"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🟢 Safe Route" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Floating Risk Summary Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapRiskSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="90dp"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="6dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMapRiskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Area Safe — No Fire Detected"
                        android:textColor="@color/safe"
                        android:textSize="@dimen/text_section_heading" />

                    <TextView
                        android:id="@+id/tvMapRiskDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="All IoT sensors normal • Monitoring active"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivMapRiskIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/safe" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapEvacuateSafely"
                style="@style/Widget.FireSafe.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="View Verified Shelters" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

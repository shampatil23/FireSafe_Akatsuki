<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_bottom_hud"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="28dp">

    <!-- Modern Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Top Header Row: Severity Badge (Left) & Close Button (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Severity Badge Pill -->
        <LinearLayout
            android:id="@+id/layoutSheetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_extreme"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/ivSheetBadgeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_fire"
                app:tint="@color/extreme" />

            <TextView
                android:id="@+id/tvSheetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="HIGH PRIORITY THREAT"
                android:textColor="@color/extreme"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Circular Close Button -->
        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_safe"
            android:backgroundTint="@color/surface_variant"
            android:clickable="true"
            android:contentDescription="Close alert details"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Threat Title -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:text="Active Wildfire Ridge Fire"
        android:textColor="@color/text_primary"
        android:textSize="21sp" />

    <!-- Location & Live Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tvSheetLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Vetal Hills Ridge, North-East Sector"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSheetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_safe"
            android:backgroundTint="@color/surface_variant"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="● Active • 14m ago"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Detailed Situation Briefing -->
    <TextView
        android:id="@+id/tvSheetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:text="Elevated thermal anomaly detected nearby. Wildfire behavior unpredictable due to wind gusts. Local authorities recommend preparing emergency grab bags."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Redesigned Telemetry Strip: 3 Clean Metric Cards + Live Environment Pill -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutSheetTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 3 Columns Metric Headers & Values -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Distance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.05"
                        android:text="DISTANCE"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="4.2 km"
                        android:textColor="@color/extreme"
                        android:textSize="17sp" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerSheetTelemetry1"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="@color/border" />

                <!-- Direction -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.05"
                        android:text="BEARING"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:text="North-East"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerSheetTelemetry2"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="@color/border" />

                <!-- Spread Rate -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.05"
                        android:text="SPREAD RATE"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetSpread"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="0.8 km/h"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Micro-Telemetry Weather Strip (Separates wind & temp so spread column stays uncluttered) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_safe"
                android:backgroundTint="@color/surface"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvSheetWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="💨 Wind: 15.6 km/h  •  🌡️ Temp: 30.1°C  •  💧 Humidity: 45%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recommended Protocol Box (Redesigned with Icon & Clear Directive) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSheetProtocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/safe_subtle"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/safe_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layoutSheetProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSheetProtocolIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/safe" />

                <TextView
                    android:id="@+id/tvSheetProtocolTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="RECOMMENDED SAFETY PROTOCOL"
                    android:textColor="@color/safe"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSheetProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:text="Evacuate toward South-West concrete buffer zone immediately."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons (Balanced, High-contrast, Pill Styled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Primary Evacuation CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetEvacuate"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/extreme"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.03"
            android:text="START EVACUATION"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_turn_straight"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/white" />

        <!-- View On Map CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetViewMap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.03"
            android:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:text="VIEW ON MAP"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_compass"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

</LinearLayout>

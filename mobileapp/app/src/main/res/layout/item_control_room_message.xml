<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 1. SYSTEM / TICKET NOTIFICATION PILL (Centered) -->
    <LinearLayout
        android:id="@+id/layoutSystemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_whatsapp_system_pill"
            android:elevation="0.5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvSystemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="System message"
                android:textColor="#54656F"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSystemTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10:45 AM"
                android:textColor="#8696A0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. MANAGER MESSAGE BUBBLE (Left-aligned WhatsApp White Bubble) -->
    <LinearLayout
        android:id="@+id/layoutManagerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_whatsapp_bubble_manager"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <!-- Manager Header: Name & Radio Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/whatsapp_teal_dark" />

                <TextView
                    android:id="@+id/tvManagerSenderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Control Room Manager"
                    android:textColor="@color/whatsapp_teal_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Message Text -->
            <TextView
                android:id="@+id/tvManagerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:text="Manager reply..."
                android:textColor="#111B21"
                android:textSize="14sp" />

            <!-- Timestamp at bottom right -->
            <TextView
                android:id="@+id/tvManagerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="10:45 AM"
                android:textColor="#667781"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. CITIZEN (USER) MESSAGE BUBBLE (Right-aligned WhatsApp Green Bubble) -->
    <LinearLayout
        android:id="@+id/layoutCitizenContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_whatsapp_bubble_user"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <!-- Message Text -->
            <TextView
                android:id="@+id/tvCitizenText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Citizen text..."
                android:textColor="#111B21"
                android:textSize="14sp" />

            <!-- Time & Double Blue Checkmarks -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCitizenTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:45 AM"
                    android:textColor="#667781"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/ivCitizenCheck"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="3dp"
                    android:src="@drawable/ic_whatsapp_check_double" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

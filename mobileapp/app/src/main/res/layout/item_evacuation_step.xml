<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvStepNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_sos_circle"
        android:backgroundTint="@color/primary"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Turn RIGHT onto Senapati Bapat Rd"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvStepDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="in 450 meters"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <!-- Hazard Avoidance Badge if applicable -->
        <TextView
            android:id="@+id/tvHazardNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge_high"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="⚠️ AI Avoidance: North ridge fire active"
            android:textColor="@color/high"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

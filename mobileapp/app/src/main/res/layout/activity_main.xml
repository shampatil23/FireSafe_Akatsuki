<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP BAR: Location selector & Notification bell -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:elevation="0dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="44dp"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Location Selector Dropdown -->
                <LinearLayout
                    android:id="@+id/layoutLocationSelector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layoutLocationHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTopLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/default_location"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/btnLocationDropdown"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="5dp"
                            android:contentDescription="Select monitored region"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTopUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/updated_just_now"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <!-- Online / Offline status badge -->
                <TextView
                    android:id="@+id/tvTopConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_safe"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="ONLINE"
                    android:textColor="@color/safe"
                    android:textSize="11sp" />

                <!-- Bell / Alerts icon button with notification badge -->
                <FrameLayout
                    android:id="@+id/layoutNotificationBell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/text_primary" />

                    <!-- Unread alert dot -->
                    <View
                        android:id="@+id/viewUnreadBellDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_sos_circle" />
                </FrameLayout>
            </LinearLayout>


        </LinearLayout>

        <!-- MAIN SCREENS CONTAINER -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. Home Dashboard -->
            <include
                android:id="@+id/viewHome"
                layout="@layout/layout_home" />

            <!-- 2. Live Map -->
            <include
                android:id="@+id/viewMap"
                layout="@layout/layout_map"
                android:visibility="gone" />

            <!-- 3. Real-Time Alerts -->
            <include
                android:id="@+id/viewAlerts"
                layout="@layout/layout_alerts"
                android:visibility="gone" />

            <!-- 4. Citizen Account -->
            <include
                android:id="@+id/viewAccount"
                layout="@layout/layout_account"
                android:visibility="gone" />

            <!-- Dedicated Overlay Screens -->
            <include
                android:id="@+id/viewEvacuation"
                layout="@layout/layout_evacuation" />

            <include
                android:id="@+id/viewSanthiChat"
                layout="@layout/layout_santhi_chat" />

            <include
                android:id="@+id/viewShelters"
                layout="@layout/layout_shelters_directory" />

            <include
                android:id="@+id/viewPrecautions"
                layout="@layout/layout_precautions" />

            <!-- WhatsApp Style Control Room Screen -->
            <include
                android:id="@+id/viewControlRoom"
                layout="@layout/layout_control_room" />

            <!-- Emergency SOS Sheet Modal -->
            <include
                android:id="@+id/viewSosDialog"
                layout="@layout/layout_sos_dialog" />

            <!-- Send Fire Alert Sheet Modal -->
            <include
                android:id="@+id/viewSendAlertDialog"
                layout="@layout/layout_send_alert_dialog" />
        </FrameLayout>
    </LinearLayout>

    <!-- FLOATING SOS BUTTON -->
    <FrameLayout
        android:id="@+id/layoutFloatingSos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="104dp">

        <!-- 3-Second Hold SOS Custom View -->
        <com.diplomates.firesafe.ui.custom.SosHoldButton
            android:id="@+id/btnSosHold"
            android:layout_width="@dimen/sos_button_size"
            android:layout_height="@dimen/sos_button_size" />
    </FrameLayout>

    <!-- FLOATING PILL BOTTOM NAVIGATION VIEW (Uber-style minimalist capsule) -->
    <com.diplomates.firesafe.ui.custom.FloatingBottomNavView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
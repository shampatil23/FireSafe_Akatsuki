<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNavContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="34dp"
    app:cardElevation="10dp"
    app:cardMaxElevation="12dp"
    app:strokeColor="#EDEDED"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">

        <!-- 1. Home Tab -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_pill_active"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="3dp"
                android:paddingEnd="16dp"
                android:paddingBottom="3dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/icon_home"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_home"
                        android:src="@drawable/ic_nav_home" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/nav_home"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Services Tab -->
        <FrameLayout
            android:id="@+id/nav_services"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_services"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="3dp"
                android:paddingEnd="16dp"
                android:paddingBottom="3dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/icon_services"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_map"
                        android:src="@drawable/ic_nav_map" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_services"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/nav_map"
                    android:textColor="#5E5E5E"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Alerts Tab -->
        <FrameLayout
            android:id="@+id/nav_activity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_activity"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="3dp"
                android:paddingEnd="16dp"
                android:paddingBottom="3dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/icon_activity"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_alerts"
                        android:src="@drawable/ic_nav_alerts" />

                    <!-- Optional alert indicator dot -->
                    <View
                        android:id="@+id/dot_activity"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_nav_blue_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/nav_alerts"
                    android:textColor="#5E5E5E"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 4. Account Tab -->
        <FrameLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_account"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="3dp"
                android:paddingEnd="16dp"
                android:paddingBottom="3dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/icon_account"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_account"
                        android:src="@drawable/ic_nav_account" />

                    <!-- Blue Notification Dot (Shown like in uploaded Uber reference) -->
                    <View
                        android:id="@+id/dot_account"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/bg_nav_blue_dot"
                        android:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/label_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/nav_account"
                    android:textColor="#5E5E5E"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

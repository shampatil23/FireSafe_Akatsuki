<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- SANthi AI Assistant Message Container -->
    <LinearLayout
        android:id="@+id/layoutAiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:orientation="vertical">

        <!-- AI Identity Header Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_santhi_avatar_gradient">

                <ImageView
                    android:id="@+id/ivAiSenderIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ai_sparkle"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAiSenderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="SANthi AI Assistant"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_safe"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="✦ AI CORE"
                android:textColor="@color/safe"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="12:04 PM"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- AI Bubble Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvAiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3.5dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:text="AI Response message..."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic Action / Suggestion Chips -->
        <HorizontalScrollView
            android:id="@+id/scrollSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Citizen / User Message Container -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- User Bubble Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="18dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvUserText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2.5dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="User message..."
                android:textColor="@color/white"
                android:textIsSelectable="true"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- User Timestamp Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUserTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:04 PM"
                android:textColor="@color/text_tertiary"
                android:textSize="10.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_whatsapp_check_double"
                app:tint="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Theme — Deep Navy + Ember Orange System -->
    <style name="Base.Theme.Firesafe" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Component Defaults -->
        <item name="materialCardViewStyle">@style/Widget.FireSafe.Card</item>
        <item name="materialButtonStyle">@style/Widget.FireSafe.Button</item>
    </style>


    <style name="Theme.Firesafe" parent="Base.Theme.Firesafe" />

    <!-- ============================
         Card Component
         ============================ -->
    <style name="Widget.FireSafe.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius_large</item>
        <item name="cardElevation">@dimen/card_elevation_subtle</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ============================
         Button Components
         ============================ -->
    <style name="Widget.FireSafe.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/card_radius_medium</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_cta</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.FireSafe.Button.Danger" parent="Widget.FireSafe.Button">
        <item name="backgroundTint">@color/extreme</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.FireSafe.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/card_radius_medium</item>
        <item name="android:minHeight">@dimen/button_height_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.FireSafe.Button.Accent" parent="Widget.FireSafe.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ============================
         Bottom Navigation
         ============================ -->
    <style name="Widget.FireSafe.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@color/surface</item>
        <item name="elevation">12dp</item>
    </style>


    <!-- ============================
         Text Styles
         (explicit Material3 parents to avoid aapt resolution errors)
         ============================ -->
    <style name="TextAppearance.FireSafe.SectionHeading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_section_heading</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.FireSafe.CardHeading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_card_heading</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FireSafe.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FireSafe.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

</resources>